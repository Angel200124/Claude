# ─────────────────────────────────────────────────────────────
# WhatsApp Cloud API (Meta) — WhatsApp Business Platform oficial
# ─────────────────────────────────────────────────────────────
# Sacalos de developers.facebook.com > tu App > WhatsApp > API Setup
WHATSAPP_TOKEN=EAAG...tu_token_permanente
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Inventá cualquier string larga y ponela también en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=cambia-esto-por-un-secreto-largo
WHATSAPP_GRAPH_API_VERSION=v21.0

# ─────────────────────────────────────────────────────────────
# Dropi — AJUSTAR con la documentación real de tu cuenta
# (Panel de Dropi > Integraciones > API, o el doc que te dieron
# al generar tu API key). Ver src/dropi/client.ts para el detalle
# exacto de qué campo se usa dónde.
# ─────────────────────────────────────────────────────────────
DROPI_API_BASE_URL=https://api.dropi.co
DROPI_API_KEY=tu_api_key_de_dropi
# Nombre del header de autenticación y prefijo del valor.
# Por defecto se manda:  Authorization: Bearer <DROPI_API_KEY>
DROPI_AUTH_HEADER_NAME=Authorization
DROPI_AUTH_HEADER_PREFIX=Bearer
# Paths relativos a DROPI_API_BASE_URL — AJUSTAR a los reales
DROPI_CREATE_ORDER_PATH=/api/orders
DROPI_ORDER_STATUS_PATH=/api/orders/:id

# Cada cuántos minutos se revisa el estado de los pedidos abiertos en Dropi
POLL_INTERVAL_MINUTES=15
# Estados que se consideran "finales" (no se vuelve a consultar ese pedido).
# Separados por coma, en minúscula, tal como los devuelve Dropi.
DROPI_TERMINAL_STATUSES=entregado,cancelado,devuelto

# Mientras DROPI_API_KEY esté vacía, cada pedido nuevo se guarda igual y se
# te avisa por WhatsApp a este número (el tuyo, formato como en Meta:
# código de país + número, sin "+" ni espacios) para que lo cargues a mano
# en Dropi y le mandes la guía al cliente. Cuando agregues DROPI_API_KEY,
# esto deja de usarse — los pedidos se crean solos.
OWNER_NOTIFICATION_PHONE=

# ─────────────────────────────────────────────────────────────
# Modo de conversación
# ─────────────────────────────────────────────────────────────
# "rules" (default) -> flujo de reglas fijas, sin IA, 100% predecible.
# "ai"               -> Claude conversa libremente y también toma el pedido
#                       (la confirmación final sigue siendo un paso fijo en
#                       código, nunca decidido por la IA — ver aiFlow.ts).
CONVERSATION_MODE=rules
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# Info de tu negocio que la IA puede usar para responder preguntas
# (precios, tiempos de envío, políticas de cambio, etc.). Texto libre.
BUSINESS_FAQ_CONTEXT="Somos una tienda de [rubro]. Envíos a todo el país en 2-5 días hábiles."
BUSINESS_NAME="Mi Tienda"

# ─────────────────────────────────────────────────────────────
# Servidor
# ─────────────────────────────────────────────────────────────
PORT=3000
DB_PATH=./data/bot.sqlite
